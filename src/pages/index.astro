---
import Layout from "../layouts/Layout.astro";
import Avatar from "../components/Avatar.astro";
import { CONFIG, NOTA_MIN, NOTA_MAX } from "../config";
---
<Layout bare>
  <section class="login">
    <div class="login__brand">
      <div class="login__glow"></div>
      <img src="/logo-clein-white.png" alt="CLEIN Perú 2026" class="login__logo" />
      <span class="eyebrow eyebrow--light">{CONFIG.subtitulo}</span>
      <h1 class="login__title">Despega<br />CLEIN</h1>
      <p class="login__tagline">
        Plataforma oficial de calificación de jurados de la hackathon del XXXIV CLEIN Perú 2026.
      </p>
      <ul class="login__facts">
        <li><b>{CONFIG.jurados.length}</b><span>Jurados</span></li>
        <li><b>{CONFIG.criterios.length}</b><span>Criterios</span></li>
        <li><b>{NOTA_MIN}–{NOTA_MAX}</b><span>Escala</span></li>
      </ul>
    </div>

    <div class="login__panel">
      <div class="page-head">
        <span class="eyebrow">Panel de jurados</span>
        <h2 class="login__heading">Acceso de Jurados</h2>
        <p>Selecciona tu perfil e ingresa tu clave asignada para calificar.</p>
      </div>

      <div class="judges">
        {CONFIG.jurados.map((j) => (
          <button class={`judge c-${j.color}`} data-id={j.id} data-name={j.nombre} data-initials={j.iniciales} data-color={j.color}>
            <Avatar text={j.iniciales} color={j.color} />
            <span class="judge__body">
              <span class="judge__name">{j.nombre}</span>
              <span class="judge__meta">Jurado · Ingresar <span class="arrow">→</span></span>
            </span>
          </button>
        ))}
        <button class="judge judge--org c-org" data-id={CONFIG.admin.id} data-name={CONFIG.admin.nombre} data-initials="⚙" data-color="org">
          <Avatar text="⚙" />
          <span class="judge__body">
            <span class="judge__name">{CONFIG.admin.nombre}</span>
            <span class="judge__meta">Rankings y puntajes <span class="arrow">→</span></span>
          </span>
        </button>
      </div>
    </div>
  </section>

  <!-- Modal de clave -->
  <div class="modal" id="pinModal" hidden>
    <div class="modal__backdrop" data-close></div>
    <form class="modal__card" id="pinForm" autocomplete="off">
      <span class="avatar avatar--lg" id="pinAvatar"></span>
      <h2 class="modal__title" id="pinName"></h2>
      <p class="modal__hint">Ingresa tu clave asignada</p>
      <div class="pin-field">
        <input class="input input--pin" id="pinInput" type="password" maxlength="40" placeholder="••••••"
          autocapitalize="none" autocorrect="off" spellcheck="false" required />
        <button type="button" class="pin-eye" id="pinEye" aria-label="Mostrar clave" aria-pressed="false">
          <svg class="eye-open" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>
          <svg class="eye-closed" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 3l18 18"/><path d="M10.6 5.1A9.8 9.8 0 0 1 12 5c6.4 0 10 7 10 7a17 17 0 0 1-3.2 4.2M6.6 6.6C3.8 8.4 2 12 2 12s3.6 7 10 7a9.7 9.7 0 0 0 5.4-1.6"/><path d="M9.9 9.9a3 3 0 0 0 4.2 4.2"/></svg>
        </button>
      </div>
      <p class="modal__error" id="pinError" hidden>Clave incorrecta. Inténtalo de nuevo.</p>
      <div class="modal__actions">
        <button type="button" class="btn btn--ghost" data-close>Cancelar</button>
        <button type="submit" class="btn btn--primary">Ingresar</button>
      </div>
    </form>
  </div>
</Layout>

<script>
  import { CONFIG } from "../config";
  import { findJudge, getSession, setSession, prefetchRemote } from "../lib/store";

  // Si ya hay sesión, ir directo a su vista.
  const current = getSession();
  if (current === CONFIG.admin.id) location.replace("/admin");
  else if (findJudge(current)) location.replace("/jurado");

  // Mientras el jurado elige su perfil y escribe la clave, Firebase se descarga en segundo plano.
  setTimeout(prefetchRemote, 300);

  const modal = document.getElementById("pinModal")!;
  const form = document.getElementById("pinForm") as HTMLFormElement;
  const input = document.getElementById("pinInput") as HTMLInputElement;
  const error = document.getElementById("pinError")!;
  const avatar = document.getElementById("pinAvatar")!;
  const eye = document.getElementById("pinEye")!;
  let target: string | null = null;

  // Botón del ojito: alterna entre mostrar y ocultar la clave.
  const setVisible = (show: boolean) => {
    input.type = show ? "text" : "password";
    eye.classList.toggle("is-on", show);
    eye.setAttribute("aria-pressed", String(show));
    eye.setAttribute("aria-label", show ? "Ocultar clave" : "Mostrar clave");
  };
  eye.addEventListener("click", () => {
    setVisible(input.type === "password");
    input.focus();
  });

  function open(btn: HTMLElement) {
    target = btn.dataset.id!;
    avatar.className = `avatar avatar--lg c-${btn.dataset.color}`;
    avatar.textContent = btn.dataset.initials!;
    document.getElementById("pinName")!.textContent = btn.dataset.name!;
    error.hidden = true;
    setVisible(false);
    input.value = "";
    modal.hidden = false;
    setTimeout(() => input.focus(), 30);
  }
  const close = () => { modal.hidden = true; target = null; };

  document.querySelectorAll<HTMLElement>(".judge").forEach((b) => b.addEventListener("click", () => open(b)));
  modal.addEventListener("click", (e) => { if ((e.target as HTMLElement).hasAttribute("data-close")) close(); });
  document.addEventListener("keydown", (e) => { if (e.key === "Escape" && !modal.hidden) close(); });

  form.addEventListener("submit", (e) => {
    e.preventDefault();
    const judge = findJudge(target);
    const expected = judge ? judge.clave : CONFIG.admin.clave;
    if (input.value.trim() !== expected) {
      error.hidden = false;
      form.classList.remove("shake"); void form.offsetWidth; form.classList.add("shake");
      input.select();
      return;
    }
    setSession(target);
    location.href = judge ? "/jurado" : "/admin";
  });
</script>
